# Virtual environment
.venv/
venv/

# Byte-compiled
__pycache__/
*.py[cod]

# Test and tool caches
.pytest_cache/
.claude/

# Extraction cache and validation artifacts (regenerable from scripts)
cache/
validation_output/
scripts/cache/
scripts/validation_output/

# Data: regenerated by the pipeline, never shipped (Yahoo Finance terms). reproduce.sh
# recreates data/raw and data/processed.
data/

# Assembled-read intermediates
paper.html
paper_full.md

# Paper and figures: held back from the first public commit. The paper is in preparation, and
# a file committed once persists in history, so these stay out entirely until the paper is ready.
# figures/ is regenerated by reproduce.sh; paper/ and paper.pdf are added in a later commit.
paper/
paper.pdf
figures/

# Agent operating-rules file: kept local, not published
CLAUDE.md

# Development history (phase memos, session log, kickoff prompts, self-audits): a private
# working log, not part of the public repository. SPEC.md Section 13 cites it internally.
development/

# OS cruft
.DS_Store
